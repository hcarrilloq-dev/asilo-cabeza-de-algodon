# Copia este archivo como ".env" y llena tus valores. El archivo .env NUNCA se sube a GitHub.

# Servidor
PORT=4000
# URL del frontend (para permitir las peticiones / CORS)
FRONTEND_URL=http://localhost:3000

# SQL Server (autenticación de SQL Server, TCP/IP habilitado)
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=AsiloCabezaAlgodon
DB_USER=asilo_app
DB_PASSWORD=escribe_aqui_la_contraseña
# Si tu instancia tiene nombre (ej. localhost\SQLEXPRESS) escribe solo el nombre aquí y deja DB_PORT vacío
DB_INSTANCE=

# Seguridad: escribe una cadena larga y aleatoria
JWT_SECRET=cambia_esto_por_una_clave_larga_y_aleatoria
JWT_EXPIRES=8h

# Usuarios de prueba que crea "npm run seed" (mínimo 8 caracteres, con mayúscula y número)
SEED_ADMIN_EMAIL=admin@cabezadealgodon.com
SEED_PASSWORD=escribe_aqui_la_contraseña_de_prueba
